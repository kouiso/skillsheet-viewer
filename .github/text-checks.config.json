{
  "$comment": "skillsheet-viewer 用の設定（#615）。判定の本体は .github/scripts/text-checks.cjs（brain #110 の共通版ができたら写しに差し替える）。禁止語・顧客名・秘密の名前の一覧は公開リポに置けないため、ここには一般的な形だけを入れる。",
  "marker": "<!-- text-checks:615 -->",
  "skipActors": ["github-actions[bot]", "dependabot[bot]", "renovate[bot]", "devin-ai-integration[bot]"],
  "skipIssueLabels": ["alert", "security-alert", "ci-failure", "history-capacity"],
  "issue": {
    "requiredSections": [
      {
        "name": "背景",
        "aliases": ["(Why?)なぜ、このタスクをやるのか？", "タスク概要"]
      },
      {
        "name": "今どこまで",
        "aliases": []
      },
      {
        "name": "次にやること",
        "aliases": ["(How To ?) やり方の指定があるか？"]
      },
      {
        "name": "誰の判断待ち",
        "aliases": []
      },
      {
        "name": "完了条件",
        "aliases": ["(Complete!) 完成の定義(箇条書き)", "受け入れ基準"]
      }
    ]
  },
  "pullRequest": {
    "requiredSections": [
      {
        "name": "概要",
        "aliases": []
      },
      {
        "name": "変更内容",
        "aliases": ["見て欲しいポイント"]
      }
    ],
    "relatedIssuePattern": "\\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?|refs?)\\s+#\\d+"
  },
  "publicContent": {
    "rules": [
      {
        "id": "private-key",
        "label": "秘密鍵",
        "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
      },
      {
        "id": "aws-access-key",
        "label": "AWSのアクセスキー",
        "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
      },
      {
        "id": "github-token",
        "label": "GitHubのトークン",
        "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{60,})"
      },
      {
        "id": "slack-token",
        "label": "Slackのトークン",
        "pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}"
      },
      {
        "id": "api-key-sk",
        "label": "APIキー（sk-形式）",
        "pattern": "\\bsk-(?:proj-|ant-)?[A-Za-z0-9_-]{20,}"
      },
      {
        "id": "google-api-key",
        "label": "GoogleのAPIキー",
        "pattern": "\\bAIza[0-9A-Za-z_-]{35}"
      },
      {
        "id": "jwt",
        "label": "JWT",
        "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"
      },
      {
        "id": "secret-assignment",
        "label": "秘密の値の代入",
        "pattern": "(?:password|passwd|secret|api[_-]?key|access[_-]?token)\\s*[:=]\\s*['\"]?[^\\s'\"<>]{8,}",
        "flags": "i"
      },
      {
        "id": "db-connection-string",
        "label": "DBの接続文字列",
        "pattern": "\\b(?:postgres(?:ql)?|mysql|mongodb(?:\\+srv)?|redis|libsql)://[^\\s/:@]+:[^\\s/@]+@",
        "flags": "i"
      },
      {
        "id": "personal-email",
        "label": "個人のメールアドレス",
        "pattern": "\\b[A-Za-z0-9._%+-]+@(?:gmail\\.com|googlemail\\.com|yahoo\\.co\\.jp|yahoo\\.com|icloud\\.com|me\\.com|outlook\\.com|outlook\\.jp|hotmail\\.com|hotmail\\.co\\.jp|live\\.jp|docomo\\.ne\\.jp|ezweb\\.ne\\.jp|softbank\\.ne\\.jp)\\b",
        "flags": "i"
      }
    ]
  }
}
