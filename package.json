{
  "name": "skillsheet-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Engineer Skill Sheet Viewer - Display engineer skill sheets",
  "author": "kouiso",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "volta": {
    "node": "22.21.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . --error-on-warnings && node scripts/check-jsdom-pdf-assertions.mjs && node scripts/check-telemetry-imports.mjs && ./scripts/check-naming.sh",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.config.node.ts && vitest run --config vitest.config.pdf.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:playwright": "NODE_OPTIONS=--conditions=react-server playwright test",
    "test:e2e": "pnpm build && node scripts/headless-e2e.mjs",
    "test:e2e:playwright": "pnpm build && pnpm test:playwright",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "env:decrypt": "tmp=$(mktemp .env.tmp.XXXXXX) && sops -d --input-type dotenv --output-type dotenv .env.enc > \"$tmp\" && mv \"$tmp\" .env",
    "env:encrypt": "tmp=$(mktemp .env.enc.tmp.XXXXXX) && sops -e --input-type dotenv --output-type dotenv --filename-override .env.enc .env > \"$tmp\" && mv \"$tmp\" .env.enc"
  },
  "dependencies": {
    "@better-auth/core": "^1.6.25",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.3.1",
    "@react-pdf/textkit": "6.3.0",
    "@sentry/nextjs": "^10.73.0",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.6.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.11",
    "posthog-js": "^1.424.1",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "ws": "^8.18.0",
    "yet-another-react-lightbox": "^3.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@next/bundle-analyzer": "^16.2.11",
    "@playwright/test": "^1.51.1",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/nextjs-vite": "^10.5.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.0.9",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^27.0.1",
    "pdfjs-dist": "4.10.38",
    "storybook": "^10.5.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "next>sharp": ">=0.35.0",
      "postcss": "^8.5.23",
      "sharp": "^0.35.3",
      "brace-expansion@>=3": "^5.0.9",
      "test-exclude": "^8.0.0",
      "fast-uri@3": "^3.1.7",
      "nanoid": "^3.3.17",
      "browserslist": "^4.28.7"
    },
    "patchedDependencies": {
      "@react-pdf/textkit@6.3.0": "patches/@react-pdf__textkit@6.3.0.patch"
    }
  }
}
