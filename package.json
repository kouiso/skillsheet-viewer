{
  "name": "skillsheet-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Engineer Skill Sheet Viewer - Display engineer skill sheets",
  "author": "KosukeIsogai",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "volta": {
    "node": "22.21.1"
  },
  "scripts": {
    "dev": "pnpm --filter @skillsheet/web dev",
    "build": "pnpm --filter @skillsheet/web build",
    "start": "pnpm --filter @skillsheet/web start",
    "lint": "biome check . --error-on-warnings",
    "format": "biome format --write .",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm build && node scripts/headless-e2e.mjs",
    "test:e2e:playwright": "pnpm build && pnpm --filter @skillsheet/web test:playwright",
    "db:generate": "pnpm --filter @skillsheet/db db:generate",
    "db:migrate": "pnpm --filter @skillsheet/db db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "next>sharp": ">=0.35.0",
      "postcss": "^8.5.23",
      "sharp": "^0.35.3",
      "brace-expansion@>=3": "^5.0.9",
      "test-exclude": "^8.0.0",
      "fast-uri@3": "^3.1.5"
    },
    "patchedDependencies": {
      "@react-pdf/textkit@6.3.0": "patches/@react-pdf__textkit@6.3.0.patch"
    }
  }
}
