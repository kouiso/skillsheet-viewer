{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "outputStyle": "Concise",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/code-review-graph-hook.sh\" update",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/code-review-graph-hook.sh\" status",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
